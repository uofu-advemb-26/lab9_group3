digraph {
    idle[label="idle"];
    idle -> arriving[label="nb_approach or sb_approach"];
    arriving[label="ringing, arms up"];
    arriving -> closed[label="10 sec elapsed"];
    closed[label="ringing, arms down"];
    closed -> departing[label="nb_depart or sb_depart and (!nb_approach or !sb_approach)"];
    departing[label="ringing, arms_up"];
    departing -> closed[label="nb_approach or sb_approach"];
    departing -> idle[label="10 sec elapsed"];
}
